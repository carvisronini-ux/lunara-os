# =========================================================
# LUNARA OS ENVIRONMENT VARIABLES (v1.0.0)
# =========================================================
# NEVER commit real secrets to GitHub.
# Copy this file to .env.local and fill in your values.
# =========================================================

# ---------------------------------------------------------
# 1. SUPABASE OS (Operational State Database)
# ---------------------------------------------------------
# This is the SEPARATE Supabase project for Lunara OS
# NOT the Lunara App production database
NEXT_PUBLIC_SUPABASE_OS_URL=https://your-os-project.supabase.co
SUPABASE_OS_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------
# 2. ASSET SERVICE (Provider-Agnostic Storage)
# ---------------------------------------------------------
# The abstraction layer for all media storage
ASSET_SERVICE_ENDPOINT=https://api.your-asset-service.com
ASSET_SERVICE_API_KEY=your_asset_service_key

# ---------------------------------------------------------
# 3. INTERNAL OS SECURITY
# ---------------------------------------------------------
# Generate strong random strings for these
OS_JWT_SECRET=generate_a_strong_random_string_here
OS_ENCRYPTION_KEY=generate_a_32_char_hex_string_here

# ---------------------------------------------------------
# 4. EXTERNAL PROVIDERS (Managed via Resource Department)
# ---------------------------------------------------------
# These are base URLs and metadata, not direct credentials
# Actual credentials are managed through the Access Lease system

# TikTok
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=your_channel_id

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key

# Instagram/Meta
INSTAGRAM_ACCESS_TOKEN=your_instagram_token

# AI Providers (routed through Resource Manager)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ---------------------------------------------------------
# 5. MONITORING & OBSERVABILITY
# ---------------------------------------------------------
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true

# ---------------------------------------------------------
# 6. FEATURE FLAGS
# ---------------------------------------------------------
ENABLE_SIMULATION_MODE=false
ENABLE_VIRTUAL_OFFICE=true
ENABLE_EXPERIMENT_ENGINE=false